{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commuter",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Email Routing send binding (free). Sends only to verified destination
  // addresses; the recipient comes from the CONTACT_TO secret, never this repo.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "MAIL_FROM": "offers@commutai.com",
    // Public Turnstile site key (safe to publish; the secret key is a Worker secret).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFuyNYeHFz_cIJPO",
    "TURNSTILE_HOSTNAMES": "commutai.com,www.commutai.com"
  },
  // Keep variables added in the dashboard across deploys.
  "keep_vars": true,
  "routes": [
    { "pattern": "commutai.com", "custom_domain": true },
    { "pattern": "www.commutai.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
